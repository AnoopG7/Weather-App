// Production Prisma Schema for Weather Forecast
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id          String   @id @default(uuid())
  name        String
  state       String?
  country     String   @default("India")
  countryCode String   @default("IN") @map("country_code")
  latitude    Float
  longitude   Float
  osmPlaceId  BigInt?  @unique @map("osm_place_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("cities")
}

model WeatherCache {
  id              String   @id @default(uuid())
  cityName        String   @unique @map("city_name")
  latitude        Float
  longitude       Float
  currentPayload  Json     @map("current_payload")
  forecastPayload Json     @map("forecast_payload")
  cachedAt        DateTime @default(now()) @map("cached_at")
  expiresAt       DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("weather_cache")
}

model SearchLog {
  id             BigInt   @id @default(autoincrement())
  queryTerm      String   @map("query_term")
  resolvedCity   String?  @map("resolved_city")
  ipHash         String   @map("ip_hash")
  responseTimeMs Int      @map("response_time_ms")
  statusCode     Int      @map("status_code")
  cached         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([queryTerm])
  @@index([createdAt])
  @@map("search_logs")
}

model ExportLog {
  id            BigInt   @id @default(autoincrement())
  cityName      String   @map("city_name")
  daysRequested Int      @map("days_requested")
  rowsGenerated Int      @map("rows_generated")
  fileSizeBytes Int      @map("file_size_bytes")
  ipHash        String   @map("ip_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([cityName])
  @@map("export_logs")
}

model FavoriteCity {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  cityName     String   @map("city_name")
  state        String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([sessionId, cityName])
  @@index([sessionId])
  @@map("favorite_cities")
}
